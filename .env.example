# ========================================================
# LapZon E-Commerce Platform - Environment Configuration
# ========================================================

# Server Port
PORT=8080

# ========================================================
# Official Google OAuth 2.0 / OpenID Connect Credentials
# ========================================================
# Obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

# 1. Google Client ID (Public identifier)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 2. Google Client Secret (Backend only - NEVER exposed to frontend)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 3. Authorized Redirect URI (Must match Google Cloud Console exactly)
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# JWT Secret Key
JWT_SECRET=lapzon_secure_jwt_production_secret_2026
