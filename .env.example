# ========================================================
# LapZon E-Commerce Platform - Environment Configuration
# ========================================================

# Server Port
PORT=8081

# ========================================================
# Official Google OAuth 2.0 / OpenID Connect Credentials
# ========================================================
# Obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials

# 1. Google Client ID (Public identifier)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 2. Google Client Secret (Backend only - NEVER exposed to frontend)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 3. Authorized Redirect URI (Must match Google Cloud Console exactly)
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# JWT Secret Key
JWT_SECRET=lapzon_secure_jwt_production_secret_2026

# ========================================================
# Official SendGrid Web API v3 Configuration
# ========================================================
# 1. SendGrid API Key (starts with SG.)
# Obtain from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# 2. Verified Sender Email
# Must be verified under Single Sender Verification or Domain Authentication:
# https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL=verified_sender@yourdomain.com

# 3. Verified Sender Name
SENDGRID_FROM_NAME="LapZon Security"

